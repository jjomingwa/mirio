{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "Crowntrail self or independent review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "review_id",
    "created_at_utc",
    "backlog_item_id",
    "reviewer_role",
    "independent_of_implementer",
    "verdict",
    "acceptance_results",
    "counterexamples",
    "missing_evidence",
    "blocking_findings",
    "non_blocking_findings",
    "evidence_ids"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "backlog_item_id": {
      "type": "string",
      "pattern": "^Q-[0-9]{3}-[A-Z0-9-]+$"
    },
    "reviewer_role": {
      "enum": [
        "implementer_self_review",
        "independent_agent",
        "independent_human",
        "target_player",
        "qualified_legal_reviewer",
        "independent_analyst"
      ]
    },
    "independent_of_implementer": {
      "type": "boolean"
    },
    "verdict": {
      "enum": ["PASS", "FAIL", "UNKNOWN"]
    },
    "acceptance_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_check", "status", "evidence_ids", "notes"],
        "properties": {
          "acceptance_check": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["PASS", "FAIL", "UNKNOWN"]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_blocking_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "blocking_findings": {
            "maxItems": 0
          },
          "missing_evidence": {
            "maxItems": 0
          },
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewer_role": {
            "enum": [
              "independent_agent",
              "independent_human",
              "target_player",
              "qualified_legal_reviewer",
              "independent_analyst"
            ]
          }
        },
        "required": ["reviewer_role"]
      },
      "then": {
        "properties": {
          "independent_of_implementer": {
            "const": true
          }
        }
      }
    }
  ]
}
