{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goal.schema.json",
  "title": "Crowntrail web slice goal contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "title",
    "objective",
    "status",
    "delivery_target",
    "experience_contract",
    "acceptance_authority",
    "truth_policy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["UNPROVEN", "PROVEN"]
    },
    "delivery_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "platform",
        "input",
        "target_audience",
        "estimated_playtime_minutes"
      ],
      "properties": {
        "store": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "target_audience": {
          "type": "string",
          "minLength": 1
        },
        "estimated_playtime_minutes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "experience_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_mechanic",
        "handcrafted_world",
        "boss_fight_and_ending",
        "save_system"
      ],
      "properties": {
        "core_mechanic": {
          "type": "string",
          "minLength": 1
        },
        "handcrafted_world": {
          "type": "string",
          "minLength": 1
        },
        "boss_fight_and_ending": {
          "type": "string",
          "minLength": 1
        },
        "save_system": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_acceptance_required", "automated_test_authority"],
      "properties": {
        "user_acceptance_required": {
          "const": true
        },
        "automated_test_authority": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "truth_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_evidence_statuses",
        "no_evidence_status",
        "self_review_can_complete_goal",
        "all_required_gates_must_pass"
      ],
      "properties": {
        "allowed_evidence_statuses": {
          "const": ["PASS", "FAIL", "UNKNOWN"]
        },
        "no_evidence_status": {
          "const": "UNKNOWN"
        },
        "self_review_can_complete_goal": {
          "const": false
        },
        "all_required_gates_must_pass": {
          "const": true
        }
      }
    }
  }
}
