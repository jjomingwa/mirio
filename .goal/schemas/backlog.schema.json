{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backlog.schema.json",
  "title": "Crowntrail deterministic backlog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "items"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "title",
        "target_gate",
        "status",
        "problem_evidence",
        "hypothesis",
        "expected_metric_delta",
        "scope",
        "dependencies",
        "acceptance_checks",
        "verification_commands",
        "human_checks",
        "risks",
        "blockers",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q-[0-9]{3}-[A-Z0-9-]+$"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "target_gate": {
          "type": "string",
          "pattern": "^G[0-6]$"
        },
        "status": {
          "enum": ["ready", "active", "blocked", "review", "done"]
        },
        "problem_evidence": {
          "$ref": "#/$defs/string_list"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "expected_metric_delta": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/string_list"
        },
        "dependencies": {
          "$ref": "#/$defs/string_list"
        },
        "acceptance_checks": {
          "$ref": "#/$defs/string_list",
          "minItems": 1
        },
        "verification_commands": {
          "$ref": "#/$defs/string_list"
        },
        "human_checks": {
          "$ref": "#/$defs/string_list"
        },
        "risks": {
          "$ref": "#/$defs/string_list"
        },
        "blockers": {
          "$ref": "#/$defs/string_list"
        },
        "evidence_ids": {
          "$ref": "#/$defs/string_list"
        },
        "human_evidence_ids": {
          "$ref": "#/$defs/string_list"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "blocked_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "result", "record", "created_at"],
            "properties": {
              "type": {
                "enum": ["self", "independent"]
              },
              "result": {
                "enum": ["PASS", "FAIL", "UNKNOWN"]
              },
              "record": {
                "type": "string",
                "minLength": 1
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "done"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
