{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gates.schema.json",
  "title": "Crowntrail gate contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "status_values",
    "no_evidence_policy",
    "gates"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "status_values": {
      "const": ["PASS", "FAIL", "UNKNOWN"]
    },
    "no_evidence_policy": {
      "const": "UNKNOWN"
    },
    "gates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["PASS", "FAIL", "UNKNOWN"]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "status",
        "automatable",
        "evidence_required",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^W[0-5]-R[1-9][0-9]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "automatable": {
          "type": "boolean"
        },
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "platform_independent_work_may_continue",
        "evidence_ids",
        "requirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^W[0-5]$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "platform_independent_work_may_continue": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
