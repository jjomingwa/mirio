{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-review.schema.json",
  "title": "Externally produced Crowntrail independent review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "review_id",
    "receipt_id",
    "created_at_utc",
    "backlog_item_id",
    "target_gate",
    "task_contract_sha256",
    "source_fingerprint_sha256",
    "evidence_bundle_sha256",
    "reviewer",
    "verdict",
    "acceptance_results",
    "counterexamples",
    "missing_evidence",
    "blocking_findings",
    "non_blocking_findings",
    "provenance"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "backlog_item_id": {
      "type": "string",
      "pattern": "^Q-[0-9]{3}-[A-Z0-9-]+$"
    },
    "target_gate": {
      "type": "string",
      "pattern": "^G[0-6]$"
    },
    "task_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "source_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "evidence_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "role",
        "provider",
        "session_id",
        "independent_of_implementer"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["independent_agent", "independent_human"]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "independent_of_implementer": {
          "const": true
        }
      }
    },
    "verdict": {
      "enum": ["PASS", "FAIL", "UNKNOWN"]
    },
    "acceptance_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptance_result"
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_blocking_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signed_payload_sha256", "signature"],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "signed_payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "acceptance_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_check",
        "acceptance_check_sha256",
        "status",
        "evidence_ids",
        "notes"
      ],
      "properties": {
        "acceptance_check": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_check_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "status": {
          "enum": ["PASS", "FAIL", "UNKNOWN"]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
