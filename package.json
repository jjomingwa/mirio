{
  "name": "crowntrail-kingdom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "goal": "node scripts/goal.mjs",
    "goal:status": "node scripts/goal.mjs status",
    "goal:next": "node scripts/goal.mjs next",
    "goal:validate": "node scripts/validate-goal.mjs",
    "verify:fast": "node scripts/verify.mjs fast",
    "verify:browser": "node scripts/verify.mjs browser",
    "verify:release": "node scripts/verify.mjs release",
    "inventory:assets": "node scripts/inventory-assets.mjs",
    "audit:assets": "node scripts/inventory-assets.mjs --check",
    "audit:release": "node scripts/release-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.2.10",
    "@fontsource-variable/nunito": "^5.2.7",
    "howler": "^2.2.4",
    "phaser": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
